{
    "name": "andmemasin/query-builder",
    "description": "Framework-free query rules: turn rules JSON into a SQL WHERE clause with bound parameters, plus a <query-builder> web component to edit them.",
    "type": "library",
    "license": "MIT",
    "keywords": ["query builder", "rules", "filter", "sql", "web component"],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Andmemasin\\QueryBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Andmemasin\\QueryBuilder\\Tests\\": "tests/"
        }
    }
}
